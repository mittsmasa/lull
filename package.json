{
  "name": "lull",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:preview": "NEXT_PUBLIC_VERCEL_ENV=preview next dev",
    "build": "next build && serwist build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "prepare": "test -n \"$CI\" || next typegen",
    "type-check": "next typegen && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:vrt": "VRT=1 vitest run --project storybook",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": "24.18.1"
  },
  "dependencies": {
    "@emulators/adapter-next": "0.12.2",
    "@emulators/google": "0.12.2",
    "@hono/zod-validator": "0.9.1",
    "@libsql/client": "0.18.0",
    "@phosphor-icons/react": "2.1.10",
    "@serwist/next": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "html5-qrcode": "2.3.8",
    "motion": "12.42.2",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "postcss": "8.5.30",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.33.0",
    "server-only": "0.0.1",
    "serwist": "9.5.13",
    "sonner": "2.0.8",
    "stripe": "22.3.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@serwist/build": "9.5.13",
    "@serwist/cli": "9.5.13",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@types/node": "25.9.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.11",
    "lefthook": "2.2.2",
    "playwright": "1.64.1",
    "storybook": "10.6.2",
    "storybook-addon-vrt": "0.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
